# Copy to .env (git-ignored) to run LiveDeviceTest against a real PiKVM.
# Real environment variables with the same names take precedence.
PIKVM_URL=https://pikvm/
PIKVM_USER=admin
PIKVM_PASSWORD=admin
# Contents of /etc/kvmd/totp.secret on the PiKVM; leave empty when 2FA is disabled.
PIKVM_TOTP_SECRET=
